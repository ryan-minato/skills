{
  "name": "<project name>",
  "image": "<base image, e.g. nvidia/cuda:<tag> — enumerate live tags first>",
  "hostRequirements": {
    "gpu": "optional"
  },
  // GPU access is the GPU container builder's decision: NVIDIA adds
  // "--gpus", "all"; ROCm adds "--device", "/dev/kfd", "--device", "/dev/dri".
  // Shared memory: DataLoader workers exhaust Docker's default.
  "runArgs": ["<GPU flags from the container decision>", "--shm-size", "<e.g. 8gb>"],
  "features": {
    "ghcr.io/stacit-ai/devcontainer-features/uv:1": {},
    "ghcr.io/guiyomh/features/just:0": {}
  },
  "postCreateCommand": "just setup",
  "containerEnv": {
    "HF_HOME": "/workspaces/<project name>/.hf-cache"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
