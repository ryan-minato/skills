{
  "name": "<project name>",
  "image": "<base image, e.g. nvidia/cuda:<tag> — enumerate live tags first>",
  "hostRequirements": {
    "gpu": "optional"
  },
  "features": {
    "ghcr.io/stacit-ai/devcontainer-features/uv:1": {}
  },
  "postCreateCommand": "uv sync && uv run pre-commit install",
  "containerEnv": {
    "HF_HOME": "/workspaces/<project name>/.hf-cache"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
