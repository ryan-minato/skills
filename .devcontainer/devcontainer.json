// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
  "name": "Ubuntu Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/hoshiori-dev/devcontainer-features/deno:1": {},
    "ghcr.io/hoshiori-dev/devcontainer-features/uv:1": {
      "toolsToInstall": "pre-commit,rust-just,ruff"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "editorconfig.editorconfig",
        "github.copilot",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-vscode-remote.remote-containers"
      ],
      "mcp": {
        "servers": {
          "agentskills": {
            "url": "https://agentskills.io/mcp",
            "type": "http"
          }
        }
      }
    }
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.tools/bin:${containerEnv:PATH}",
    "OPENSPEC_NO_UPDATE_CHECK": "1",
    "DO_NOT_TRACK": "1",
    "PAGER": "cat",
    "GIT_PAGER": "cat",
    "GH_PAGER": "cat"
  },
  "postCreateCommand": "just setup"
}
