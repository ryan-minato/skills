# Command rules for Codex in this repository (read only when the project is
# trusted). Policy and reasons: .agents/knowledge/agent-authority.md,
# `## Permission entries`. No `prompt` rule: everything not listed here is
# judged by the approvals reviewer. The most restrictive matching rule wins.

# --- forbidden: clear security risk ---------------------------------------

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease", "--mirror", "--all", "--tags"]],
    decision = "forbidden",
    justification = "Rewrites or floods the remote; push one named ref without force.",
    match = ["git push --force origin x"],
    not_match = ["git push origin x"],
)

prefix_rule(
    pattern = ["git", "push", "origin", "--delete"],
    decision = "forbidden",
    justification = "Deletes a remote branch.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Destroys uncommitted work; commit it or use git reset --soft.",
    match = ["git reset --hard HEAD"],
    not_match = ["git reset --soft HEAD~1", "git reset -- file"],
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-fdx", "-xdf", "-df"]],
    decision = "forbidden",
    justification = "Deletes untracked work.",
)

prefix_rule(
    pattern = ["git", "checkout", "--", "."],
    decision = "forbidden",
    justification = "Discards every uncommitted change in the working tree.",
    match = ["git checkout -- ."],
    not_match = ["git checkout -- file", "git checkout main"],
)

prefix_rule(
    pattern = ["git", "restore", "."],
    decision = "forbidden",
    justification = "Discards every uncommitted change in the working tree.",
    not_match = ["git restore file"],
)

prefix_rule(
    pattern = ["git", "branch", "-D", "main"],
    decision = "forbidden",
    justification = "Deletes the local default branch.",
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "Merging is the maintainer's.",
)

prefix_rule(
    pattern = ["gh", "pr", "review", ["--approve", "-a"]],
    decision = "forbidden",
    justification = "Approving is the maintainer's.",
)

prefix_rule(
    pattern = ["gh", "api", ["-X", "--method"], ["DELETE", "PUT", "PATCH"]],
    decision = "forbidden",
    justification = "Changes repository settings or deletes objects; settings are the maintainer's.",
)

prefix_rule(
    pattern = ["gh", "repo", ["delete", "edit"]],
    decision = "forbidden",
    justification = "Repository deletion and settings are the maintainer's.",
)

prefix_rule(
    pattern = ["gh", "auth", "token"],
    decision = "forbidden",
    justification = "Prints the credential into the session.",
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "No privilege escalation in the dev container.",
)

prefix_rule(
    pattern = ["rm", "-rf", ["/", "~", ".", "/workspaces/skills"]],
    decision = "forbidden",
    justification = "Deletes the system, home, or repository.",
)

# Any command naming the approval label is the maintainer's; Codex prefix
# rules cannot match an argument anywhere, so the gh label forms are listed.
prefix_rule(
    pattern = ["gh", "pr", "edit", ["--add-label", "--remove-label"], "spec/approved"],
    decision = "forbidden",
    justification = "spec/approved is the maintainer's to add or remove; read it with just spec-approval.",
)

# --- allow: the per-task checks -------------------------------------------

prefix_rule(
    pattern = ["just", ["check", "test", "validate", "lint", "spec-validate", "check-skill", "spec-check", "review-threads", "spec-approval", "commit-gate"]],
    decision = "allow",
    justification = "The repository's documented checks, run on every task.",
    match = ["just check", "just check-skill skills/core/x"],
    not_match = ["just gen-marketplace"],
)
